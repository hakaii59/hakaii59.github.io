---
interface StringTitleProp {
  pageTitle: string;
  pageDesc?: string;
}

interface ArrayTitleProp {
  pageTitle: [string, string];
  titleTransition: string;
  pageDesc?: string;
}

export type Props = StringTitleProp | ArrayTitleProp;

const { props } = Astro;
---

<main id="main-content" class="wrap pb-6">
  {
    "titleTransition" in props ? (
      <h1 class="prompt-heading">
        {props.pageTitle[0]}
        <span transition:name={props.titleTransition}>
          {props.pageTitle[1]}
        </span>
      </h1>
    ) : (
      <h1 class="prompt-heading">{props.pageTitle}</h1>
    )
  }
  {props.pageDesc && <p class="mt-2 text-sm text-skin-muted">{props.pageDesc}</p>}
  <div class="mt-7">
    <slot />
  </div>
</main>
