---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-8 flex items-center gap-x-4 border-t border-skin-line pt-5 font-mono text-sm"
      aria-label="Pagination"
    >
      {page.url.prev && (
        <a href={page.url.prev} class="mr-auto more-link">
          &larr; Previous posts
        </a>
      )}
      {page.url.next && (
        <a href={page.url.next} class="ml-auto more-link">
          Next posts &rarr;
        </a>
      )}
    </nav>
  )
}
