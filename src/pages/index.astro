---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import PostCard from "@components/PostCard";
import { HOME, PROFILE, SITE } from "@config";
import getSortedPosts from "@utils/getSortedPosts";
import getTagsWithCount from "@utils/getTagsWithCount";
import getCategory, {
  getCategoriesWithCount,
  getSubcategory,
} from "@utils/getCategory";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);

const recentPosts = sortedPosts.slice(0, SITE.postPerIndex);
const sections = getCategoriesWithCount(sortedPosts);
const tags = getTagsWithCount(sortedPosts).slice(0, 20);

/**
 * The intro paragraphs are authored with `**bold**` only, so a one-rule
 * conversion is enough — no markdown pipeline needed for two sentences.
 */
const inlineBold = (text: string) =>
  text.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
---

<Layout>
  <Header activeNav="home" />
  <main id="main-content" class="wrap">
    {
      PROFILE.banner && (
        <img
          src={PROFILE.banner}
          alt=""
          class="mb-8 h-40 w-full rounded-md border border-skin-line object-cover sm:h-52"
        />
      )
    }

    <section aria-labelledby="whoami">
      <h1 id="whoami" class="prompt-heading">{HOME.heading}</h1>
      <div class="mt-3 space-y-3">
        {HOME.intro.map(paragraph => <p set:html={inlineBold(paragraph)} />)}
      </div>
      <p class="mt-4 font-mono text-xs text-skin-muted">
        {
          PROFILE.contacts.map(({ label, href }, index) => (
            <>
              {index > 0 && <span aria-hidden="true"> &middot; </span>}
              <a
                href={href}
                class="text-skin-accent underline decoration-skin-accent/40 underline-offset-4 hover:decoration-skin-accent"
              >
                {label}
              </a>
            </>
          ))
        }
      </p>
    </section>

    <div class="divider" aria-hidden="true">* * *</div>

    <section aria-labelledby="sections">
      <h2 id="sections" class="prompt-heading">{HOME.sectionsHeading}</h2>
      <ul class="mt-3 space-y-3 p-0">
        {
          sections.map(({ key, label, blurb, count }) => (
            <li class="list-none">
              <a href={`/${key}/`} class="group block">
                <span class="font-mono text-sm font-semibold text-skin-accent group-hover:underline">
                  {label}/
                </span>
                <span class="ml-2 font-mono text-xs text-skin-muted">
                  {count}
                </span>
                <span class="block text-sm text-skin-muted">{blurb}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="divider" aria-hidden="true">* * *</div>

    <section aria-labelledby="recent">
      <h2 id="recent" class="prompt-heading">{HOME.recentHeading}</h2>
      <ul class="mt-2 divide-y divide-skin-line p-0">
        {
          recentPosts.map(post => (
            <PostCard
              href={`/posts/${post.slug}/`}
              frontmatter={post.data}
              categoryLabel={getCategory(post).short}
              subcategoryLabel={getSubcategory(post)}
            />
          ))
        }
      </ul>
      <p class="mt-4">
        <a href="/posts/" class="more-link">View all &rarr;</a>
      </p>
    </section>

    <div class="divider" aria-hidden="true">* * *</div>

    <section aria-labelledby="tags">
      <h2 id="tags" class="prompt-heading">{HOME.tagsHeading}</h2>
      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
        {
          tags.map(({ tag, tagName, count }) => (
            <a
              href={`/tags/${tag}/`}
              class="tag-link"
              aria-label={`View all posts tagged ${tagName}`}
            >
              #{tagName}
              <span class="opacity-60"> {count}</span>
            </a>
          ))
        }
      </div>
      <p class="mt-4">
        <a href="/tags/" class="more-link">View all &rarr;</a>
      </p>
    </section>
  </main>

  <Footer />
</Layout>
