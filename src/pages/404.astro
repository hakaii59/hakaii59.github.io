---
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main id="main-content" class="wrap flex flex-1 items-center justify-center">
    <div class="py-20 text-center">
      <p class="font-mono text-6xl font-bold text-skin-accent sm:text-7xl">
        404
      </p>
      <p class="mt-4 font-mono text-sm text-skin-muted">
        segmentation fault &mdash; no such page
      </p>
      <a href="/" class="more-link mt-8 inline-block">&larr; Back home</a>
    </div>
  </main>

  <Footer />
</Layout>
